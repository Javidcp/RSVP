generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model event {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  location    String
  eventDate   DateTime
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  user        user     @relation(fields: [createdById], references: [id], map: "Event_createdById_fkey")
  rsvp        rsvp[]

  @@index([createdById], map: "Event_createdById_idx")
  @@index([eventDate], map: "Event_eventDate_idx")
}

model rsvp {
  id        Int         @id @default(autoincrement())
  userId    Int
  eventId   Int
  status    rsvp_status
  createdAt DateTime    @default(now())
  updatedAt DateTime
  event     event       @relation(fields: [eventId], references: [id], onDelete: Cascade, map: "RSVP_eventId_fkey")
  user      user        @relation(fields: [userId], references: [id], onDelete: Cascade, map: "RSVP_userId_fkey")

  @@unique([userId, eventId], map: "RSVP_userId_eventId_key")
  @@index([eventId], map: "RSVP_eventId_idx")
  @@index([userId], map: "RSVP_userId_idx")
}

model user {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique(map: "User_email_key")
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  event        event[]
  rsvp         rsvp[]
}

enum rsvp_status {
  GOING
  MAYBE
  DECLINED
}
